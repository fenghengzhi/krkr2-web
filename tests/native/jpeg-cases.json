{
  "schema": 1,
  "sentinel": 165,
  "scope": "Fixed IJG6b encoder-generated independent byte fixtures and fixed TVPLoadJPEG C caller. Numeric errors/warnings/public row batches are observed; no browser decoder is an oracle.",
  "bases": {
    "gray0": { "kind": "gray0", "width": 8, "height": 8 },
    "gray64": { "kind": "gray64", "width": 8, "height": 8 },
    "gray255": { "kind": "gray255", "width": 8, "height": 8 },
    "rgbconstant": { "kind": "rgbconstant", "width": 3, "height": 2 },
    "gray": { "kind": "gray", "width": 17, "height": 19 },
    "y444": { "kind": "y444", "width": 17, "height": 19 },
    "y422": { "kind": "y422", "width": 17, "height": 19 },
    "y420": { "kind": "y420", "width": 17, "height": 19 },
    "rgb": { "kind": "rgb", "width": 17, "height": 19 },
    "cmyk": { "kind": "cmyk", "width": 17, "height": 19 },
    "ycck": { "kind": "ycck", "width": 17, "height": 19 },
    "unknown": { "kind": "unknown", "width": 17, "height": 19 },
    "progressive": { "kind": "y420", "width": 17, "height": 19, "progressive": true },
    "restart": { "kind": "y420", "width": 65, "height": 49, "restart": 3 },
    "padding": { "kind": "y420", "width": 17, "height": 19, "padding": true }
  },
  "cases": [
    { "id": "constant-gray0", "base": "gray0", "expect": "complete", "constant": 0 },
    { "id": "constant-gray64", "base": "gray64", "expect": "complete", "constant": 64 },
    { "id": "constant-gray255", "base": "gray255", "expect": "complete", "constant": 255 },
    { "id": "constant-rgb", "base": "rgbconstant", "expect": "complete", "constantRgb": [32, 96, 160] },
    { "id": "gray-normal", "base": "gray", "expect": "complete" },
    { "id": "gray-gray", "base": "gray", "mode": "grayscale", "expect": "complete" },
    { "id": "y444-normal", "base": "y444", "expect": "complete" },
    { "id": "y444-gray", "base": "y444", "mode": "grayscale", "expect": "complete" },
    { "id": "y422-normal", "base": "y422", "expect": "complete" },
    { "id": "y422-gray", "base": "y422", "mode": "grayscale", "expect": "complete" },
    { "id": "y420-normal", "base": "y420", "expect": "complete" },
    { "id": "y420-gray", "base": "y420", "mode": "grayscale", "expect": "complete" },
    { "id": "rgb-normal", "base": "rgb", "expect": "complete" },
    { "id": "rgb-gray", "base": "rgb", "mode": "grayscale", "expect": "codec-error", "code": "CONVERSION_NOTIMPL" },
    { "id": "cmyk-normal", "base": "cmyk", "expect": "complete" },
    { "id": "cmyk-gray", "base": "cmyk", "mode": "grayscale", "expect": "codec-error", "code": "CONVERSION_NOTIMPL" },
    { "id": "ycck-normal", "base": "ycck", "expect": "complete" },
    { "id": "ycck-gray", "base": "ycck", "mode": "grayscale", "expect": "codec-error", "code": "CONVERSION_NOTIMPL" },
    { "id": "unknown-normal", "base": "unknown", "expect": "complete" },
    { "id": "unknown-gray", "base": "unknown", "mode": "grayscale", "expect": "codec-error", "code": "CONVERSION_NOTIMPL" },
    { "id": "progressive-normal", "base": "progressive", "expect": "complete" },
    { "id": "progressive-gray", "base": "progressive", "mode": "grayscale", "expect": "complete" },
    { "id": "restart-normal", "base": "restart", "expect": "complete" },
    { "id": "padding-normal", "base": "padding", "expect": "complete" },
    { "id": "y420-low", "base": "y420", "precision": "low", "expect": "complete" },
    { "id": "y420-low-gray", "base": "y420", "precision": "low", "mode": "grayscale", "expect": "complete" },
    { "id": "y444-high", "base": "y444", "precision": "high", "expect": "complete" },
    { "id": "y420-high", "base": "y420", "precision": "high", "expect": "complete" },
    { "id": "empty", "mutation": "empty", "expect": "codec-error", "code": "INPUT_EMPTY" },
    { "id": "not-jpeg", "mutation": "not-jpeg", "expect": "codec-error", "code": "NO_SOI" },
    { "id": "soi-only", "mutation": "soi-only", "expect": "codec-error", "code": "NO_IMAGE" },
    { "id": "missing-eoi", "base": "y420", "mutation": "missing-eoi", "expect": "complete", "eofWarning": true },
    { "id": "progressive-missing-eoi", "base": "progressive", "mutation": "missing-eoi", "expect": "complete", "eofWarning": true },
    { "id": "entropy-truncated", "base": "y420", "mutation": "cut-entropy", "expect": "observed" },
    { "id": "restart-truncated", "base": "restart", "mutation": "cut-entropy", "expect": "observed" },
    { "id": "tail-duplicate-soi", "base": "y420", "mutation": "duplicate-soi", "expect": "codec-error", "code": "SOI_DUPLICATE" },
    { "id": "progressive-duplicate-soi", "base": "progressive", "mutation": "duplicate-soi", "expect": "codec-error", "code": "SOI_DUPLICATE" },
    { "id": "bad-precision", "base": "y420", "mutation": "bad-precision", "expect": "codec-error", "code": "BAD_PRECISION" },
    { "id": "bad-dqt", "base": "y420", "mutation": "bad-dqt", "expect": "codec-error", "code": "DQT_INDEX" },
    { "id": "bad-huffman", "base": "y420", "mutation": "bad-huffman", "expect": "codec-error", "code": "BAD_HUFF_TABLE" },
    { "id": "unsupported-sof", "base": "y420", "mutation": "unsupported-sof", "expect": "codec-error", "code": "SOF_UNSUPPORTED" },
    { "id": "padding-truncated", "base": "padding", "mutation": "cut-padding", "expect": "observed" },
    { "id": "trailing-bytes", "base": "y420", "mutation": "trailing-bytes", "expect": "complete" }
  ]
}
