// Original SDK observation, only through the GitHub-hosted Windows workflow.
// Records unknown VCL results without predeclaring their values. No plugin,
// external input, timers, fonts, browser runtime or allocation stress is used.
var nativeRows=[],nativeEffects=0;
function nativeRecord(text){nativeRows.add(text);nativeRows.save("native-events.txt");}
function nativeErrorText(error){return (string(error.message)).escape();}
System.exceptionHandler=function(error){nativeRecord("error:"+nativeErrorText(error));System.exit();return true;};
function nativeResult(id,outcome,inputType,inputText,resultType,resultText,errorText){
  nativeRecord("case|"+id+"|"+outcome+"|"+inputType+"|"+inputText+"|"+resultType+"|"+resultText+"|"+nativeEffects+"|"+errorText);
}
function nativeColor(id,value){
  nativeEffects=0;
  var inputType=typeof value,inputText=value===void?"void":string(value);
  try{
    var result=System.toActualColor(value);
    nativeResult(id,"returned",inputType,inputText,typeof result,string(result),"");
  }catch(error){nativeResult(id,"error",inputType,inputText,"","",nativeErrorText(error));}
}
function nativeEntry(id,action){
  nativeEffects=0;
  try{
    var result=action();
    nativeResult(id,"returned","entry","see-case-manifest",typeof result,string(result),"");
  }catch(error){nativeResult(id,"error","entry","see-case-manifest","","",nativeErrorText(error));}
}
property nativeBadColor {getter(){nativeEffects++;return <% 01 02 %>;}}
