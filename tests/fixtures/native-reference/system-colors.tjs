// One private hidden window and one 2x2 Layer, reset before every pixel case.
// Setup failure is fatal; per-operation errors remain recorded observations.
var nativeWindow=new Window();nativeWindow.visible=false;
var nativeLayer=new Layer(nativeWindow,null);
nativeLayer.type=ltAlpha;nativeLayer.setSize(2,2);nativeLayer.setImageSize(2,2);
nativeLayer.setClip(0,0,2,2);
function nativeResetLayer(){
  nativeLayer.face=dfAlpha;nativeLayer.holdAlpha=false;
  nativeLayer.fillRect(0,0,2,2,0x57112233);
  nativeLayer.setProvincePixel(0,0,0);
}
function nativeLayerCase(id,action){
  nativeEffects=0;nativeResetLayer();
  try{
    action();
    var result=string(nativeLayer.getMainPixel(0,0))+","+string(nativeLayer.getMaskPixel(0,0))+","+string(nativeLayer.getProvincePixel(0,0));
    nativeResult(id,"returned","layer-operation","see-case-manifest","pixel-triplet",result,"");
  }catch(error){nativeResult(id,"error","layer-operation","see-case-manifest","","",nativeErrorText(error));}
}
nativeLayerCase("layer-fill-opaque-hold",function(){nativeLayer.face=dfOpaque;nativeLayer.holdAlpha=true;nativeLayer.fillRect(0,0,1,1,clWindow);});
nativeLayerCase("layer-fill-opaque-replace",function(){nativeLayer.face=dfOpaque;nativeLayer.holdAlpha=false;nativeLayer.fillRect(0,0,1,1,clWindow);});
nativeLayerCase("layer-fill-alpha",function(){nativeLayer.face=dfAlpha;nativeLayer.fillRect(0,0,1,1,clWindow);});
nativeLayerCase("layer-fill-addalpha",function(){nativeLayer.face=dfAddAlpha;nativeLayer.fillRect(0,0,1,1,clWindow);});
nativeLayerCase("layer-set-main-window",function(){nativeLayer.setMainPixel(0,0,clWindow);});
nativeLayerCase("layer-set-main-high01",function(){nativeLayer.setMainPixel(0,0,0x01010203);});
nativeLayerCase("layer-color-alpha",function(){nativeLayer.face=dfAlpha;nativeLayer.colorRect(0,0,1,1,clWindow,255);});
nativeLayerCase("layer-color-alpha-zero",function(){nativeLayer.face=dfAlpha;nativeLayer.colorRect(0,0,1,1,clWindow,0);});
nativeLayerCase("layer-color-alpha-negative",function(){nativeLayer.face=dfAlpha;nativeLayer.colorRect(0,0,1,1,clWindow,-255);});
nativeLayerCase("layer-color-opaque",function(){nativeLayer.face=dfOpaque;nativeLayer.colorRect(0,0,1,1,clWindow,255);});
nativeLayerCase("layer-color-addalpha-zero",function(){nativeLayer.face=dfAddAlpha;nativeLayer.colorRect(0,0,1,1,clWindow,0);});
nativeLayerCase("layer-fill-mask",function(){nativeLayer.face=dfMask;nativeLayer.fillRect(0,0,1,1,clWindow);});
nativeLayerCase("layer-color-mask",function(){nativeLayer.face=dfMask;nativeLayer.colorRect(0,0,1,1,clWindow,255);});
nativeLayerCase("layer-fill-province",function(){nativeLayer.face=dfProvince;nativeLayer.fillRect(0,0,1,1,clWindow);});
nativeLayerCase("layer-set-province",function(){nativeLayer.setProvincePixel(0,0,clWindow);});
nativeRecord("observations-complete");
System.exit();
