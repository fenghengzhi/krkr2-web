// Fixed SDK observations. Each scenario has a separate owned process; no
// input is injected and no candidate ordering is used as a completion oracle.
var nativeRows=[],nativeScenario="__NATIVE_SCENARIO__",nativeToken="__NATIVE_TOKEN__",nativeWindow,nativeHidden,nativeTimer,nativeMenu;
function nativeRecord(text){nativeRows.add(text);nativeRows.save("native-events.txt");}
System.exceptionHandler=function(error){nativeRecord("error:"+error.message);System.exit();return true;};
System.exitOnWindowClose=false;
System.exitOnNoWindowStartup=false;
nativeRecord("start");nativeRecord("scenario:"+nativeScenario);nativeRecord("version:"+System.versionString);
function nativeArgument(){nativeRecord("argument");return %[];}
function nativeTerminate(){nativeRecord("terminate-call");var result=System.terminate(nativeArgument(),nativeRecord("extra"));nativeRecord("terminate-return:"+int(result===void));}
function nativeExit(){nativeRecord("exit-call");try{System.exit(nativeArgument(),nativeRecord("extra"));}catch(error){nativeRecord("exit-caught:"+error.message);}nativeRecord("exit-return");}
function nativeTick(event){nativeTimer.enabled=false;nativeRecord("timer-before");nativeTerminate();nativeRecord("timer-after");}
if(nativeScenario=="plain-terminate"){
  nativeTerminate();Scripts.exec('nativeRecord("nested-after");');nativeRecord("startup-after");
}else if(nativeScenario=="plain-exit"){
  nativeExit();nativeRecord("startup-after");
}else{
  nativeWindow=new Window();nativeWindow.caption="KRKR2 termination "+nativeScenario+" "+nativeToken;nativeWindow.setInnerSize(320,240);nativeWindow.visible=true;
  nativeHidden=new Window();nativeHidden.caption="KRKR2 termination modal";
  nativeTimer=new Timer(global,"nativeTick");nativeTimer.enabled=false;nativeTimer.interval=100;
  if(nativeScenario=="timer-terminate"){
    nativeTimer.enabled=true;nativeRecord("startup-waiting");
  }else if(nativeScenario=="terminate-before-modal"){
    nativeTerminate();nativeRecord("modal-before");nativeHidden.showModal();nativeRecord("modal-after");
  }else{
    nativeTimer.enabled=true;nativeRecord("modal-before");
    if(nativeScenario=="timer-window-modal")nativeHidden.showModal();
    else if(nativeScenario=="timer-inform")System.inform("Termination observation",nativeWindow.caption);
    else if(nativeScenario=="timer-input")System.inputString(nativeWindow.caption,"Termination observation","initial");
    else if(nativeScenario=="timer-menu"){
      nativeMenu=new MenuItem(nativeWindow,"Termination popup");nativeWindow.menu.add(nativeMenu);nativeMenu.add(new MenuItem(nativeWindow,"Item "+nativeToken));
      nativeRecord("menu-owner-hwnd:"+nativeWindow.HWND);nativeRecord("popup-hmenu:"+nativeMenu.HMENU);
      nativeMenu.popup(0,20,30);
    }else throw new Exception("Unknown termination scenario");
    nativeRecord("modal-after");
  }
}
